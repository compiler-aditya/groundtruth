# Copy to .env and fill in. Never commit .env.
# Meta Model API key (dev.meta.ai -> API keys). Used by tests 1-3, the claim check and the agent.
MODEL_API_KEY=
# Baseten API key (Baseten app -> Settings -> API Keys). Used by test 4.
BASETEN_API_KEY=
# Optional: override the Spark Open model ID (hackathon keys only work with this one)
# SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026
